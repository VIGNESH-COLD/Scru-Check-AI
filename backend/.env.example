# OmniRAG & ScruCheck AI Backend Configuration

# Runtime Mode ("development" or "production")
ENVIRONMENT="development"
# Comma-separated or JSON array of allowed frontend origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Vector Store: "simple" (standalone JSON store) or "pgvector" (PostgreSQL)
VECTOR_STORE_BACKEND="simple"
# Optional Cloud PostgreSQL URL (Neon / Supabase) when VECTOR_STORE_BACKEND="pgvector"
# POSTGRES_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Override in production with a strong random secret
SECRET_KEY="change-me-in-production"

# Primary LLM Provider: Groq
LLM_PROVIDER="groq"
LLM_API_KEY="your-groq-api-key-here"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-120b"
LLM_TIMEOUT_SECONDS=30.0
LLM_RETRY_LIMIT=2

# Fallback LLM Provider: Google Gemini API
FALLBACK_LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL="gemini-flash-lite-latest"

# Dedicated Mistral Settings
MISTRAL_API_KEY="your-mistral-api-key-here"
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
MISTRAL_MODEL="ministral-8b-latest"
