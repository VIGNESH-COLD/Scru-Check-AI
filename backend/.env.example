# Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_new_key

# Database
DATABASE_URL=sqlite:///./scrucheck.db

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db

# LLM API Keys — get from https://console.mistral.ai
MISTRAL_API_KEY=CHANGE_ME_your_mistral_api_key

# Public URL used to build shareable external examiner links.
# Set this to your deployed domain or ngrok URL when running for external access.
# Leave empty to use relative paths (localhost only).
APP_PUBLIC_URL=

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
